<?xml version="1.0" encoding="utf-8"?>
<!-- PLACEHOLDER: se sustituye por la exportacion de Figma (scene_gelat.svg), 700 x 380. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CDE8F7" />
            <stroke android:width="@dimen/stroke_card" android:color="@color/ink" />
            <corners android:radius="@dimen/corner_card" />
        </shape>
    </item>
    <item
        android:height="90dp"
        android:gravity="bottom"
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#A9D79A" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
