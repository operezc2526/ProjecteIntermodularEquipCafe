<?xml version="1.0" encoding="utf-8"?>
<!-- Circulo de nivel bloqueado: gris azulado de farola apagada con candado. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/map_lamp_off" />
            <stroke android:width="@dimen/stroke_card" android:color="@color/cream" />
        </shape>
    </item>
    <item
        android:width="@dimen/icon_level_state"
        android:height="@dimen/icon_level_state"
        android:drawable="@drawable/ic_lock"
        android:gravity="center" />
</layer-list>
