<?xml version="1.0" encoding="utf-8"?>
<!-- Botón neutro de adultos («Zona adults»): fuera del flujo del infante, registro neutro. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_pressed" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/ink_50" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cream" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/ink_50" />
            <corners android:radius="36dp" />
        </shape>
    </item>
</selector>
