    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_20" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cream" />
        </shape>
    </item>
</layer-list>
