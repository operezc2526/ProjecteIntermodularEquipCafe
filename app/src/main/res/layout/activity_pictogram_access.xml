<?xml version="1.0" encoding="utf-8"?>
<!--
    S02-S04 · Acceso por 3 pictogramas (prototipo Figma 2:59 / 2:109 / 2:162). Referencia 1280 x 800 dp.
    Enrere + perfil seudónimo arriba, consigna con altavoz, 3 casillas de 130 dp y 6 cartas de 150 dp.
    Provisional hasta AND-02.3 / SEG-01.3: cualquier secuencia de 3 entra al mapa (sin validar).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.PictogramAccessActivity">

    <!-- Barra superior: Enrere · perfil · hueco simétrico -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_margin"
        android:layout_marginTop="@dimen/screen_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            style="@style/Poble.Text.CardName"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_min_height"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:drawablePadding="12dp"
            android:drawableStart="@drawable/ic_arrow_back"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="210dp"
            android:paddingHorizontal="40dp"
            android:text="@string/action_back"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/avatar_size_small"
                android:layout_height="@dimen/avatar_size_small"
                android:background="@drawable/avatar_guineu"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvProfileId"
                style="@style/Poble.Text.Prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/profiles_demo_1" />
        </LinearLayout>

        <Space
            android:layout_width="210dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Consigna -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/icon_prompt"
            android:layout_height="@dimen/icon_prompt"
            android:background="@drawable/ic_speaker"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Poble.Text.Prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/access_prompt" />
    </LinearLayout>

    <!-- Casillas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/slot1"
            android:layout_width="@dimen/picto_slot_size"
            android:layout_height="@dimen/picto_slot_size"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_slot_empty"
            android:gravity="center">

            <View
                android:id="@+id/slot1Picto"
                android:layout_width="@dimen/picto_slot_picto_size"
                android:layout_height="@dimen/picto_slot_picto_size"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot2"
            android:layout_width="@dimen/picto_slot_size"
            android:layout_height="@dimen/picto_slot_size"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_slot_empty"
            android:gravity="center">

            <View
                android:id="@+id/slot2Picto"
                android:layout_width="@dimen/picto_slot_picto_size"
                android:layout_height="@dimen/picto_slot_picto_size"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot3"
            android:layout_width="@dimen/picto_slot_size"
            android:layout_height="@dimen/picto_slot_size"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_slot_empty"
            android:gravity="center">

            <View
                android:id="@+id/slot3Picto"
                android:layout_width="@dimen/picto_slot_picto_size"
                android:layout_height="@dimen/picto_slot_picto_size"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cartas de pictogramas: 6 de 150 dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnPictoSun"
            style="@style/Poble.Card"
            android:layout_width="@dimen/picto_card_size"
            android:layout_height="@dimen/picto_card_size"
            android:layout_marginHorizontal="15dp"
            android:contentDescription="@string/picto_sun">

            <View
                android:layout_width="@dimen/picto_size"
                android:layout_height="@dimen/picto_size"
                android:background="@drawable/picto_sun"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPictoBall"
            style="@style/Poble.Card"
            android:layout_width="@dimen/picto_card_size"
            android:layout_height="@dimen/picto_card_size"
            android:layout_marginHorizontal="15dp"
            android:contentDescription="@string/picto_ball">

            <View
                android:layout_width="@dimen/picto_size"
                android:layout_height="@dimen/picto_size"
                android:background="@drawable/picto_ball"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPictoTree"
            style="@style/Poble.Card"
            android:layout_width="@dimen/picto_card_size"
            android:layout_height="@dimen/picto_card_size"
            android:layout_marginHorizontal="15dp"
            android:contentDescription="@string/picto_tree">

            <View
                android:layout_width="@dimen/picto_size"
                android:layout_height="@dimen/picto_size"
                android:background="@drawable/picto_tree"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPictoHouse"
            style="@style/Poble.Card"
            android:layout_width="@dimen/picto_card_size"
            android:layout_height="@dimen/picto_card_size"
            android:layout_marginHorizontal="15dp"
            android:contentDescription="@string/picto_house">

            <View
                android:layout_width="@dimen/picto_size"
                android:layout_height="@dimen/picto_size"
                android:background="@drawable/picto_house"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPictoFish"
            style="@style/Poble.Card"
            android:layout_width="@dimen/picto_card_size"
            android:layout_height="@dimen/picto_card_size"
            android:layout_marginHorizontal="15dp"
            android:contentDescription="@string/picto_fish">

            <View
                android:layout_width="@dimen/picto_size"
                android:layout_height="@dimen/picto_size"
                android:background="@drawable/picto_fish"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPictoStar"
            style="@style/Poble.Card"
            android:layout_width="@dimen/picto_card_size"
            android:layout_height="@dimen/picto_card_size"
            android:layout_marginHorizontal="15dp"
            android:contentDescription="@string/picto_star">

            <View
                android:layout_width="@dimen/picto_size"
                android:layout_height="@dimen/picto_size"
                android:background="@drawable/picto_star"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
