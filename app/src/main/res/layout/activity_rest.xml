<?xml version="1.0" encoding="utf-8"?>
<!--
    S14 / S19 / S22 / S27 · Descansar (prototipo Figma 3:298). Fondo azul palido del prototipo (no esta en la guia).
    Brisa, mensaje y dos botones de 340 x 100: Continuar y Anar al mapa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_rest"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".ui.RestActivity">

    <View
        android:id="@+id/brisa"
        android:layout_width="@dimen/rest_brisa_size"
        android:layout_height="@dimen/rest_brisa_size"
        android:background="@drawable/brisa"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Poble.Text.Prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="@string/rest_title" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnContinue"
            style="@style/Poble.Button.Success"
            android:layout_width="@dimen/rest_button_width"
            android:layout_height="@dimen/rest_button_height"
            android:layout_marginEnd="20dp"
            android:text="@string/action_continue"
            app:icon="@drawable/ic_play" />

        <Button
            android:id="@+id/btnMap"
            style="@style/Poble.Button.Primary"
            android:layout_width="@dimen/rest_button_width"
            android:layout_height="@dimen/rest_button_height"
            android:layout_marginStart="20dp"
            android:text="@string/action_go_map"
            app:icon="@drawable/ic_map" />
    </LinearLayout>

</LinearLayout>
