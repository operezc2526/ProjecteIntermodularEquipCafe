<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Protecció dels Usuaris (0490-RA5): allowBackup desactivado para que los perfiles
        y las sesiones de los menores no salgan del dispositivo por copias en la nube
        ni por transferencia entre dispositivos.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PobleEmocions">
        <activity
            android:name=".ui.ProfilesActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PictogramAccessActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.MapActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.QuestionLevelActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.Level3Activity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.Level4Activity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.RestActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.EndActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.AdultPinActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.AdultPanelActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.NewProfileActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ui.ExportActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
    </application>

</manifest>
